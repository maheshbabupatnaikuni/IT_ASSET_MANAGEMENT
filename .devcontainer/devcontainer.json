{
  "name": "IT Asset Management",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "forwardPorts": [5000],
  "portsAttributes": {
    "5000": {
      "label": "IT Asset Management",
      "onAutoForward": "openBrowser"
    }
  },
  "containerEnv": {
    "ITAMS_HOST": "0.0.0.0",
    "ITAMS_PORT": "5000",
    "ITAMS_ADMIN_PASSWORD": "test-only-codespace123",
    "ITAMS_ALLOW_EPHEMERAL_SECRET": "true",
    "ITAMS_OPEN_BROWSER": "false",
    "PYTHONUNBUFFERED": "1"
  },
  "postCreateCommand": "python -m pip install --upgrade pip && python -m pip install -r requirements.txt -r requirements-dev.txt && python reset_data.py",
  "postStartCommand": "python run_app.py > .runtime/codespaces.log 2>&1 &",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.debugpy"]
    }
  }
}
